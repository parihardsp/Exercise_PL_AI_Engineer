# ==============================================================================
# Portfolio Analytics Agent — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your credentials.
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Configuration
# ------------------------------------------------------------------------------
# Provider selection: 'gemini' (default) or 'groq'
LLM_PROVIDER=gemini

# Google Gemini API Key (Get one at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq API Key & Model (e.g. qwen-2.5-32b, qwen-2.5-coder-32b, llama-3.3-70b-versatile, openai/gpt-oss-120b)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen-2.5-32b

# ------------------------------------------------------------------------------
# 2. Database & Directory Paths
# ------------------------------------------------------------------------------
# Path to SQLite database file (default: ./portfolio_database.db)
DB_PATH=portfolio_database.db
DB_READ_ONLY=true


# Path to database schema DDL file
SCHEMA_PATH=database_schema.sql

# Directory containing raw CSV dataset files
DATA_DIR=data

# Directory where daily rotating log files (agent_YYYY-MM-DD.log) are saved
LOG_DIR=logs

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# 4. REST API Server Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Host interface to bind server (0.0.0.0 for external/container access, 127.0.0.1 for local only)
API_HOST=0.0.0.0

# Port for FastAPI server
API_PORT=8000

# Base URL used by Streamlit client to connect to FastAPI backend
API_BASE_URL=http://localhost:8000


# ------------------------------------------------------------------------------
# 5. LangSmith Tracing & Observability (Optional)
# ------------------------------------------------------------------------------
# Set to 'true' to enable cloud trace logging in LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=Portfolio-Analytics-Agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangChain standard environment flags (if using LangChain ecosystem tools)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=Portfolio-Analytics-Agent
